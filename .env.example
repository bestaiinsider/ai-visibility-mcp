# Copy to .env and fill from ~/Setup/credentials.md
PERPLEXITY_API_KEY=
TAVILY_API_KEY=
OPENROUTER_API_KEY=
FIRECRAWL_API_KEY=
APIFY_API_TOKEN=

# Cost guard (USD per tool call, default 0.10)
MAX_COST_PER_CALL=0.10

# Daily LLM spend ceiling (USD across all calls, default 5.00).
# Persisted to ~/.cache/ai-visibility-mcp/spend.json
MAX_DAILY_USD=5.00

# Cap on output tokens per LLM call (default 1024)
LLM_MAX_OUTPUT_TOKENS=1024
